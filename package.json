{
  "name": "dsh-dev-workbench",
  "private": true,
  "version": "0.1.0",
  "description": "三语种（C#/.NET、Kotlin/Android、ArkTS/HarmonyOS）开发工作台插件：dotnet/gradle/hvigor 构建与测试、adb/hdc 设备与日志的 DSH 工具封装，以及 DSH 设置页状态卡片。",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": {
      "default": "./src/index.js"
    },
    "./client": {
      "default": "./client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "client.js",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "keywords": [
    "deepseek",
    "dsh",
    "deepseek-harness",
    "cordis",
    "android",
    "kotlin",
    "harmonyos",
    "arkts",
    "dotnet",
    "csharp"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.2.0-rc.2"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.0"
  },
  "scripts": {}
}
